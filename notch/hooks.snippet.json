{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "%USERPROFILE%\\.claude-notch\\report.cmd busy",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "%USERPROFILE%\\.claude-notch\\report.cmd waiting \"needs you\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "%USERPROFILE%\\.claude-notch\\report.cmd idle",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "%USERPROFILE%\\.claude-notch\\report.cmd idle",
            "async": true
          }
        ]
      }
    ]
  }
}
